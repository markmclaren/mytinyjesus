{
  "name": "mytinyjesus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "node --check client/vanilla/app.js && node --check client/vanilla/messages.js",
    "format": "prettier --write client/vanilla client/index.html scripts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.6.2",
    "typescript": "5.6.3",
    "vite": "^7.1.7",
    "vite-plugin-manus-runtime": "^0.0.58"
  },
  "packageManager": "pnpm@10.4.1"
}
